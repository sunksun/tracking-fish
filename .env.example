# Firebase Configuration
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าจริงจาก Firebase Console

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# AI Fish Classifier (เฟส 2)
# URL ของ fish_api.py ต้องเป็น LAN IP ของเครื่องที่รัน API (ไม่ใช่ localhost บนมือถือจริง)
# หา IP: ipconfig getifaddr en0  แล้วรัน: venv/bin/uvicorn fish_api:app --host 0.0.0.0 --port 8000
AI_API_URL=http://192.168.1.x:8000
